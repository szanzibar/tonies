# Required: Your tonie.cloud account credentials
TONIE_USERNAME=your-tonie-email@example.com
TONIE_PASSWORD=your-tonie-password

# Language: "de" (German, default) or "en" (English)
# LANGUAGE=de

# Production only (required for deployment):
# SECRET_KEY_BASE=  # Generate with: mix phx.gen.secret
# PHX_HOST=example.com
# PORT=4000
